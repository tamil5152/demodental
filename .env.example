# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (bookings + admin login) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Comma separated list of emails allowed into /admin
ADMIN_EMAILS=owner@example.com

# --- WhatsApp Cloud API (optional: automatic confirmations & reminders) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=
# Approved template names (body params documented in README)
WHATSAPP_TEMPLATE_CONFIRMATION=appointment_confirmation
WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_REVIEW=review_request
WHATSAPP_TEMPLATE_LANG=en

# --- Cron (reminders) ---
CRON_SECRET=choose-a-random-string
